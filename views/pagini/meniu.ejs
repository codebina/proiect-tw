<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Mâncare Urgentă - meniu</title>
    <meta name="description" content="Meniu Mâncare Urgentă">
    <meta name="keywords" content="ingrediente mâncare urgentă, meniu mâncare urgentă, produse mâncare urgentă, imagini mâncare urgentă">
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/resurse/css/meniu.css" type="text/css" />
    <script type="text/javascript" src="/resurse/js/produse.js"></script>
    <script type="text/javascript" src="/resurse/js/produse-cos.js"></script>
</head>

<body>
    <%- include('../fragmente/header.ejs') %>
    <main>

        <div id="zona-filtre">
            <h2>Filtrează Meniul</h2>
            <div>
                <label> Nume: <input class="form-control" type="text" id="inp-nume" placeholder="Caută produs..."></label>
                <div class="invalid-feedback">
                    Te rog introdu un cuvânt valid (fără cifre sau caractere speciale)!
                </div>
        </div>
            <div> Opțiune vegetariană:
                <p> 
                    <input type="radio" class="btn-check" name="gr_rad" id="i_rad1" value="toate">
                    <label class="btn btn-outline-secondary" for="i_rad1">Toate</label>
                </p>
                <p> 
                    <input type="radio" class="btn-check" name="gr_rad" id="i_rad2" value="da">
                    <label class="btn btn-outline-secondary" for="i_rad2">Doar Vegetarian</label>
                </p>
                <p> 
                    <input type="radio" class="btn-check" name="gr_rad" id="i_rad3" value="nu">
                    <label class="btn btn-outline-secondary" for="i_rad3">Cu carne</label>
                </p>
            </div>
            <p>
                <label> Preț maxim:
                    <input type="range" class="form-range" id="inp-pret" value="70" min="0" max="70">
                    <span id="infoRange">(0)</span>
                </label>
            </p>

            <p>
                <label>Categorie produs:
                    <select id="inp-categorie">
                        <option id="sel-toate" selected value="toate">toate</option>
                        <% for (let opt of locals.optiuni) { %>
                            <option value="<%- opt.unnest %>"><%- opt.unnest %> </option>
                        <% } %>
                </select>
                </label>
            </p>

            <p>
                <label>Cuvinte cheie în descriere:<br>
                    <textarea id="txt-descriere" rows="2" cols="30" placeholder="Ex: zemos, cald..."></textarea>
                </label>
            </p>

            <p>
                <label>Sugestii Gramaj (g):
                    <input list="sugestii-gramaj" id="inp-gramaj" placeholder="Alege sau scrie gramaj...">
                </label>
                <datalist id="sugestii-gramaj">
                    <option value="40"></option>
                    <option value="60"></option>
                    <option value="100"></option>
                    <option value="150"></option>
                    <option value="200"></option>
                    <option value="450"></option>
                </datalist>
            </p>

            <p>
                <label>Timp de servire (Ctrl+Click pentru mai multe): <br>
                    <select id="inp-timp-servire" multiple size="3">
                        <option value="mic dejun">Mic Dejun</option>
                        <option value="toată ziua">Toată ziua</option>
                        <option value="prânz/cină">Prânz / Cină</option>
                    </select>
                </label>
            </p>

            <div class="grup-ingrediente">
                <span class="eticheta-grup">Filtrare ingrediente:</span>

                <div class="linie-ingredient">
                    <label><input type="checkbox" class="chk-ingr" value="usturoi"> Usturoi</label>
                    <span class="optiuni-radio-ingr">
                        <label><input type="radio" name="rad_usturoi" value="are" checked> are</label>
                        <label><input type="radio" name="rad_usturoi" value="nu_are"> nu are</label>
                    </span>
                </div>

                <div class="linie-ingredient">
                    <label><input type="checkbox" class="chk-ingr" value="cartofi"> Cartofi</label>
                    <span class="optiuni-radio-ingr">
                        <label><input type="radio" name="rad_cartofi" value="are" checked> are</label>
                        <label><input type="radio" name="rad_cartofi" value="nu_are"> nu are</label>
                    </span>
                </div>

                <div class="linie-ingredient">
                    <label><input type="checkbox" class="chk-ingr" value="carne pui"> Carne Pui</label>
                    <span class="optiuni-radio-ingr">
                        <label><input type="radio" name="rad_carne_pui" value="are" checked> are</label>
                        <label><input type="radio" name="rad_carne_pui" value="nu_are"> nu are</label>
                    </span>
                </div>

                <div class="linie-ingredient">
                    <label><input type="checkbox" class="chk-ingr" value="sare"> Sare</label>
                    <span class="optiuni-radio-ingr">
                        <label><input type="radio" name="rad_sare" value="are" checked> are</label>
                        <label><input type="radio" name="rad_sare" value="nu_are"> nu are</label>
                    </span>
                </div>
            </div>

            <p>
                <button class="c1 c2 c3 btn btn-secondary align-items-center gap-1" id="filtrare"><i class="bi bi-funnel"></i><span class="d-none d-sm-inline">Filtreaza</span></button>
                <button class="btn btn-secondary align-items-center gap-1" id="resetare"><i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-sm-inline">Reseteaza</span></button>
                <button class="btn btn-secondary align-items-center gap-1" id="sumar"><i class="bi bi-basket"></i> <span class="d-none d-sm-inline">Sumar</span></button>
                <button class="btn btn-secondary align-items-center gap-1" id="sortCresc"><i class="bi bi-sort-numeric-down"></i><span class="d-none d-sm-inline">Sorteaza crescator dupa gramaj/preț și timp servire</span></button>
                <button class="btn btn-secondary align-items-center gap-1" id="sortDescresc"><i class="bi bi-sort-numeric-up-alt"></i> <span class="d-none d-sm-inline">Sorteaza descrescator dupa gramaj/preț și timp servire</span></button>
            </p>
        </div>

        <p id="counter-produse">
        </p>

        <section id="sectiune-produse">
            <h2>Produsele Noastre</h2>

            <div class="produse-container">

                <% for( let prod of locals.produse) { 
                    let zileSaptamana=["Duminica", "Luni" , "Marti" , "Miercuri", "Joi" , "Vineri" , "Sambata" ]; 
                    let luniAn=["Ianuarie", "Februarie" , "Martie" , "Aprilie", "Mai" , "Iunie" , "Iulie" , "August" , "Septembrie" , "Octombrie" , "Noiembrie" , "Decembrie"]; 
                    let dataObj=new Date(prod.data_adaugare); 
                    let zi=dataObj.getDate(); 
                    let numeLuna=luniAn[dataObj.getMonth()]; 
                    let an=dataObj.getFullYear(); 
                    let ziSapt=zileSaptamana[dataObj.getDay()]; 
                    let dataFormatataRo=`${zi} ${numeLuna} ${an} [${ziSapt}]`; 
                    let clasaCategorieMare=prod.tip_produs.normalize("NFD").replace(/[\u0300-\u036f]/g, "" ).replace(/[\s\/]+/g, '-' ).toLowerCase(); 
                %>
                    <article id="artc-<%- prod.id %>" class="produs <%- clasaCategorieMare %>">

                        <h3 class="nume">
                            Nume: <a href="/meniu/<%- prod.id %>"><span class="val-nume"><%- prod.nume %></span></a>
                        </h3>

                        <div class="produs-grid-cerinta">

                            <div class="coloana-1">
                                <figure>
                                    <a href="/meniu/<%- prod.id %>">
                                        <img src="/resurse/imagini/produse/<%- prod.imagine %>" class="poza-meniu" alt="[imagine <%- prod.nume %>]" />
                                    </a>
                                </figure>

                                <ul class="info-prod">
                                    <li>
                                        <strong class="nume-caract">Preț:</strong>
                                        <span class="val-pret"><%- prod.pret %> LEI</span>
                                    </li>
                                    <li>
                                        <strong class="nume-caract">Gramaj:</strong>
                                        <span class="val-gramaj"><%- prod.gramaj %> g</span>
                                    </li>
                                    <li>
                                        <strong class="nume-caract">Timp Servire:</strong>
                                        <span class="val-timp-servire"><%- prod.categorie %></span>
                                    </li>
                                    <li>
                                        <strong class="nume-caract">Ingrediente:</strong>
                                        <span class="val-ingrediente"><%- prod.ingrediente && prod.ingrediente.length > 0 ? prod.ingrediente.join(', ') : 'Nu sunt specificate' %></span>
                                    </li>
                                    <li>
                                        <strong class="nume-caract">Data Ofertei:</strong>
                                        <span class="val-data">
                                            <time datetime="<%- prod.data_adaugare %>"><%- dataFormatataRo %></time>
                                        </span>
                                    </li>
                                    <li>
                                        <strong class="nume-caract">Vegetarian:</strong>
                                        <span class="val-vegetarian"><%- prod.vegetarian ? 'Da' : 'Nu' %></span>
                                    </li>
                                </ul>
                            </div>

                            <div class="coloana-2">
                                <p class="categorie-mare">
                                    <strong class="nume-caract">Categoria:</strong>
                                    <span class="val-categorie"><%- prod.tip_produs %></span>
                                </p>

                                <p class="descriere">
                                    <div class = "accordion">
                                        <div class = "accordion-item">
                                            <button class="accordion-button collapsed py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#acordeon-<%- prod.id %>">
                                                <strong class="nume-caract">Descriere:</strong>
                                            </button>
                                            <div id = "acordeon-<%- prod.id %>" class="accordion-collapse collapse">
                                                <div class="accordion-body">
                                                    <span class="val-descriere"><%- prod.descriere %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </p>

                                <label class="selecteaza-cos">
                                    Selectează:<br />
                                    <input type="checkbox" class="select-cos" value="<%- prod.id %>" autocomplete="off">
                                </label>
                            </div>

                        </div>
                    </article>
                <% } %>

            </div>
        </section>
    </main>
    <%- include('../fragmente/footer.ejs') %>
</body>

</html>