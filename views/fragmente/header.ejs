<script src="/resurse/js/tema.js"></script>
<script src="/resurse/js/schimba_tema.js"></script>
<header class="c1 c2 c3" id="titlu">
    <nav>
        <label id="hamburger" for="ch-menu">
            <div class="bara"></div>
            <div class="bara"></div>
            <div class="bara"></div>
        </label>
        <input type="checkbox" id="ch-menu" />

        <ul class="meniu">
            <li>
                <div class="imag-icon" id="acasa-icon">
                    <span class="fa-solid fa-house"></span>
                </div>
                <div class="text-icon" id="acasa-text"><a href="/index"> Acasă</a></div>
                <ul>
                    <li><a href="/index#welcome">Bine ați venit</a></li>
                    <li><a href="/index#promotii">Promoții</a></li>
                    <li><a href="/index#evenimente">Evenimente</a></li>
                    <li><a href="/index#produse">Oferta</a></li>
                    <li><a href="/index#program">Program</a></li>
                    <li><a href="/index#locatii">Locații</a></li>
                    <li><a href="/index#retete">Rețete</a></li>
                    <li><a href="/index#recenzii">Recenzii</a></li>
                </ul>


            </li>
            <li>
                <div class="imag-icon">
                    <span class="fa-solid fa-cart-shopping"></span>
                </div>
                <div class="text-icon"><a href="/inregistrare"> Înregistrare</a></div>
            </li>
            <li>
                <div class="imag-icon">
                    <span class="fa-solid fa-circle-info"></span>
                </div>
                <div class="text-icon"><a href="/despre"> Despre noi</a></div>
                <ul>
                    <li><a href="/despre#prezentare">Prezentare</a></li>
                    <li><a href="/despre#istoric">Istoric</a></li>
                    <li><a href="/despre#galerie-statica">Galerie</a></li>
                </ul>
            </li>
            <li>
                <div class="imag-icon">
                    <span class="fa-solid fa-utensils"></span>
                </div>
                <div class="text-icon"><a href="/meniu"> Meniu</a></div>
                <ul>
                    <% if (locals.optiuni && locals.optiuni.length> 0) { %>
                        <% for (let opt of locals.optiuni) { %>
                            <li>
                                <a href="/meniu?tip=<%- opt.unnest %>">
                                    <% let optiuniMeniu=opt.unnest.replace('-', ' ' ); %>
                                        <%- optiuniMeniu[0].toUpperCase() + optiuniMeniu.slice(1) %>
                                </a>
                            </li>
                            <% } %>
                                <% } %>
                </ul>

            </li>
            <li>
                <div class="imag-icon">
                    <span class="fa-solid fa-envelope"></span>
                </div>
                <div class="text-icon"><a href="contact.html"> Contact</a></div>
            </li>
        </ul>
    </nav>
    <div class="header-titlu">
        <img id="logo-seminte" src="/resurse/imagini/favicon.png" alt="sigla" />
        <h1>Mâncare urgentă</h1> <!-- title e titlul tabului. asta e titlul paginii-->
    </div>

    <div id="watermark">
        <p>Sabina<br>Brînzei</p>
    </div>
    <div class="d-flex align-items-center gap-2 my-2 justify-content-center">
        <i class="bi bi-sun-fill text-warning"></i>
        <div class="form-check form-switch m-0 p-0 d-flex align-items-center">
            <input class="form-check-input m-0 custom-switch" type="checkbox" id="schimba_tema" role="switch">
        </div>
        <i class="bi bi-moon-stars-fill text-secondary"></i>
    </div>
</header>